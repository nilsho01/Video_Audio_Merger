{
  "timezone": "Europe/Berlin",
  "defaults": {
    "audio": {
      "offset_s": 0.0,
      "tags_are_utc": true
    },
    "video": {
      "offset_s": 0.0,
      "tags_are_utc": true,
      "use_timecode": false
    }
  },
  "sources": {
    "gopro": {
      "tags_are_utc": true
    }
  },
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 25,
    "vcodec": "auto",
    "crf": null,
    "preset": "fast",
    "bitrate": "3M",
    "hwaccel": "auto",
    "jobs": "auto",
    "audio_rate": 48000,
    "aac_per_channel": "96k",
    "audio_tracks": "single"
  },
  "join_tolerance_s": 3.0,
  "cut_gaps": {
    "enabled": true,
    "min_gap_s": 10.0,
    "keep_s": 2.0
  },
  "audio_processing": {
    "enabled": true,
    "highpass_hz": 90,
    "denoise": "afftdn",
    "denoise_db": 12,
    "rnnoise_model": null,
    "normalize": true,
    "max_gain_db": 20,
    "target_rms": 0.12
  },
  "pip": {
    "width_fraction": 0.3,
    "margin": 40
  },
  "text": {
    "fontfile": null,
    "size": 34
  },
  "audio_sync": {
    "enabled": true,
    "audio_to_audio": true,
    "coarse": true,
    "coarse_min_ratio": 1.5,
    "coarse_min_overlap_s": 120,
    "coarse_local_s": 300.0,
    "medium": true,
    "medium_window_s": 300.0,
    "medium_excerpts": 6,
    "medium_excerpt_s": 60.0,
    "search_s": 10.0,
    "analyze_s": 30.0,
    "window_step_s": 240.0,
    "min_confidence": 8.0,
    "drift_min_span_s": 600.0
  }
}